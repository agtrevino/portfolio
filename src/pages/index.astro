---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { profile, rotatingWords, experience, skills, projects } from '../data/site';
import headshot from '../assets/headshot.png';
import appddiction from '../assets/appddiction.svg';
import jstorm from '../assets/jstorm.png';
import mattprojekt from '../assets/mattprojekt.png';
import codebound from '../assets/codebound.svg';

const logos = { appddiction, jstorm, mattprojekt, codebound };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resumeHref = profile.resumeUrl ? `${base}${profile.resumeUrl}` : '';
---

<Base>
  <header class="nav">
    <a class="brand" href="#top">{profile.firstName[0]}{profile.lastName[0]}</a>
    <nav aria-label="Main">
      <a href="#projects">Projects</a>
      <a href="#experience">Experience</a>
      <a href="#resume">Resume</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow">{profile.title}</p>
        <h1>{profile.firstName}<br /><span class="accent">{profile.lastName}</span></h1>
        <p class="lets">
          Let's
          <span class="words" aria-hidden="true">
            {rotatingWords.map((w) => <span>{w}</span>)}
          </span>
          <span class="sr-only">{rotatingWords.join(', ')}</span>
        </p>
        <p class="intro">{profile.intro}</p>
        <p class="cta">
          <a class="btn" href="#projects">View projects</a>
          <a class="btn ghost" href="#contact">Get in touch</a>
        </p>
      </div>
      <Image
        class="headshot"
        src={headshot}
        alt={`Portrait of ${profile.name}`}
        width={360}
        widths={[360, 720]}
        sizes="360px"
        loading="eager"
      />
    </section>

    <section id="projects" class="section">
      <h2>Projects</h2>
      <div class="grid">
        {projects.map((p) => (
          <article class="card">
            <div class={`logo-wrap ${p.tone}`}>
              <Image src={logos[p.logo as keyof typeof logos]} alt={`${p.name} logo`} height={120} />
            </div>
            <p class="kind">{p.kind}</p>
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            <a class="link" href={p.url} target="_blank" rel="noopener noreferrer">
              Visit {p.name}<span class="sr-only"> (opens in a new tab)</span> →
            </a>
          </article>
        ))}
      </div>
    </section>

    <section id="experience" class="section alt">
      <div class="inner">
        <h2>Experience</h2>
        {experience.map((e) => (
          <div class="job">
            <h3>{e.role}, {e.org}</h3>
            <p class="kind">{e.dates}</p>
            <p>{e.summary}</p>
          </div>
        ))}
        <h3 class="skills-title">Skills</h3>
        <ul class="skills">
          {skills.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </section>

    <section id="resume" class="section">
      <h2>Resume</h2>
      {
        resumeHref ? (
          <a class="btn" href={resumeHref} download>Download resume (PDF)</a>
        ) : (
          <p class="muted">Resume coming soon. Contact me for a copy.</p>
        )
      }
    </section>

    <section id="contact" class="section alt">
      <div class="inner">
        <h2>Contact</h2>
        <p>Email is the best way to reach me.</p>
        <p class="cta">
          <a class="btn" href={`mailto:${profile.email}`}>{profile.email}</a>
          <a class="btn ghost" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a class="btn ghost" href={profile.github} target="_blank" rel="noopener noreferrer">
            GitHub<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>© {new Date().getFullYear()} {profile.name}</p>
  </footer>
</Base>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 1.5rem;
    background: rgba(15, 17, 21, 0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .brand {
    font-family: 'Montserrat', sans-serif;
    font-weight: 800;
    text-decoration: none;
    letter-spacing: 2px;
  }
  .nav nav {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .nav nav a {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .nav nav a:hover {
    color: var(--text);
  }

  .hero,
  .section .inner,
  .section > :not(.inner) {
    max-width: var(--max);
    margin-inline: auto;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: center;
    padding: 5rem 1.5rem;
    min-height: 80vh;
  }
  .eyebrow,
  .kind {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.8rem;
    font-weight: 500;
    margin: 0 0 0.5rem;
  }
  .hero h1 {
    font-size: clamp(3rem, 9vw, 6rem);
    font-weight: 800;
    letter-spacing: -1px;
  }
  .accent {
    color: var(--accent);
  }

  .lets {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.6rem;
    font-weight: 600;
    display: flex;
    gap: 0.5ch;
    margin: 0 0 1rem;
  }
  .words {
    display: inline-block;
    height: 1.65em;
    overflow: hidden;
    color: var(--accent);
  }
  .words span {
    display: block;
    height: 1.65em;
    animation: roll 12.5s infinite;
  }
  @keyframes roll {
    0%, 16% { transform: translateY(0); }
    20%, 36% { transform: translateY(-100%); }
    40%, 56% { transform: translateY(-200%); }
    60%, 76% { transform: translateY(-300%); }
    80%, 96% { transform: translateY(-400%); }
    100% { transform: translateY(-500%); }
  }

  .intro {
    color: var(--muted);
    max-width: 52ch;
  }
  .headshot {
    width: 100%;
    max-width: 360px;
    height: auto;
    border-radius: var(--radius);
    justify-self: center;
    border: 1px solid var(--line);
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .btn {
    display: inline-block;
    padding: 0.7rem 1.3rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    border: 1px solid var(--accent);
    transition: transform 0.15s;
  }
  .btn:hover {
    transform: translateY(-2px);
  }
  .btn.ghost {
    background: transparent;
    color: var(--text);
    border-color: var(--line);
  }

  .section {
    padding: 4.5rem 1.5rem;
  }
  .section.alt {
    background: var(--bg-alt);
  }
  .section h2 {
    font-size: 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .card {
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
  }
  .card h3 {
    font-size: 1.25rem;
  }
  .card p:not(.kind) {
    color: var(--muted);
    flex: 1;
  }
  .logo-wrap {
    height: 160px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    margin-bottom: 1rem;
    padding: 1rem;
  }
  .logo-wrap.dark {
    background: #0b0d11;
  }
  .logo-wrap.light {
    background: #f1f3f7;
  }
  .logo-wrap :global(img) {
    max-height: 120px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }
  .link {
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
  }
  .link:hover {
    text-decoration: underline;
  }

  .job {
    margin-bottom: 1.5rem;
  }
  .job h3 {
    margin-bottom: 0.25rem;
  }
  .skills-title {
    margin-top: 2.5rem;
  }
  .skills {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .skills li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    font-size: 0.9rem;
  }
  .muted {
    color: var(--muted);
  }

  .footer {
    text-align: center;
    padding: 2rem 1rem;
    color: var(--muted);
    font-size: 0.9rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 3rem;
      min-height: auto;
    }
    .headshot {
      order: -1;
      max-width: 240px;
    }
  }
</style>
